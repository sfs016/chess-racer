# Local development: point the Vite client at a local SpacetimeDB instance.
#   spacetime start                                   # run local server
#   spacetime publish --server local chess-race       # publish the module
#
# For a production build, override these (e.g. Vercel env vars) with:
#   VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
#   VITE_SPACETIMEDB_DB_NAME=chess-race
VITE_SPACETIMEDB_DB_NAME=chess-race
VITE_SPACETIMEDB_HOST=ws://localhost:3000
